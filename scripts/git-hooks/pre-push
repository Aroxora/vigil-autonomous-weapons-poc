#!/usr/bin/env bash
#
# Pre-push hook — runs the full test suite before allowing a push.
#
# Replaces .github/workflows/hardening.yml. The CI workflow was free in
# dollars but cost 2,000 Actions-minutes/month on a private solo repo
# and produced an email every time a build broke (which it always does
# during refactors, where the value-to-noise ratio inverts). Running
# the same suite locally on git push keeps the regression net intact
# and sends zero email.
#
# Install once per checkout:
#   git config core.hooksPath scripts/git-hooks
#
# Bypass for an emergency push (use sparingly):
#   git push --no-verify

set -e

# Run from the repo root regardless of where the user invoked git from.
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

echo "[pre-push] running full test suite (npm test)…"
if ! npm test --silent; then
  echo
  echo "[pre-push] tests FAILED. Push aborted."
  echo "[pre-push] Fix tests, or rerun with: git push --no-verify"
  exit 1
fi

echo "[pre-push] tests passed."

# Disclosure gate — enforces vr.r.no_brokerage at the git layer.
# Refuses to push finding / writeup / exploit artifacts that haven't
# reached a coordinated-disclosure terminal yet. See
# scripts/disclosure-gate.sh for the full set of allow conditions.
if ! bash "$ROOT/scripts/disclosure-gate.sh" "$@"; then
  echo
  echo "[pre-push] disclosure gate refused the push. See output above."
  echo "[pre-push] If this is intentional, set EROSOLAR_DISCLOSURE_INTERNAL_OK=1 and retry."
  exit 1
fi

# Non-blocking timeline-staleness warning. The /about Development timeline is
# manual-curated; we previously ran an LLM workflow that silently drifted, so
# the pre-push hook nudges instead of automating writes to a marketing page.
# See scripts/update-timeline.sh for the proposal helper.
ABOUT_HTML="site/public/about.html"
if [[ -f "$ABOUT_HTML" ]]; then
  LAST_TL=$(awk '
    /<h2>Development timeline/ { in_tl = 1; next }
    in_tl && /<\/ul>/ { in_tl = 0 }
    in_tl && match($0, /<li><strong>([0-9]{4}-[0-9]{2}-[0-9]{2})<\/strong>/, m) { print m[1]; exit }
  ' "$ABOUT_HTML" 2>/dev/null || true)
  LAST_HEAD=$(git log -1 --pretty=format:'%cs' 2>/dev/null || true)
  if [[ -n "$LAST_TL" && -n "$LAST_HEAD" ]]; then
    GAP=$(( ( $(date -d "$LAST_HEAD" +%s) - $(date -d "$LAST_TL" +%s) ) / 86400 ))
    if (( GAP > 3 )); then
      echo "[pre-push] heads-up: /about timeline last entry is $LAST_TL, HEAD is $LAST_HEAD ($GAP days). Run: bash scripts/update-timeline.sh"
    fi
  fi
fi

echo "[pre-push] pushing."
